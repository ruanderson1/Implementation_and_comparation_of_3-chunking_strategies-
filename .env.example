# Local development settings. Copy this file to .env before running the CLI.
APP_NAME=Education RAG
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/education_rag
DOCUMENTS_PATH=data/documents

# Values used by Docker Compose for the local PostgreSQL container.
POSTGRES_DB=education_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
