# Environment variables and local secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
.venv-wsl/
venv/
env/

# Python bytecode and packaging artifacts
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/

# Test, coverage, lint and local-agent caches
.pytest_cache/
.codex-pytest-tmp/
pytest-cache-files-*/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Local documents may contain private material; keep the directory itself available.
data/documents/*
!data/documents/.gitkeep

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
